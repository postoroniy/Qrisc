package ModelHazardsTest where

import RegFile
import Qrisc32Model

expected :: Bit 4 -> Word32
expected idx =
    case idx of
        0 -> 19
        1 -> 24
        2 -> 24
        3 -> 3
        4 -> 31
        5 -> 0
        6 -> 42
        7 -> 11
        8 -> 100
        9 -> 19
        10 -> 5
        11 -> 0
        _ -> 77

mkModelHazardsTest :: Module Empty
mkModelHazardsTest =
    module
        imem :: RegFile MemIdx Word32 <- mkRegFileLoad "build/hex/hazards_1024.hex" 0 1023
        dmem :: RegFile MemIdx Word32 <- mkRegFileLoad "build/hex/dmem_zero_1024.hex" 0 1023
        cpu :: Qrisc32ModelIfc <- mkQrisc32Model imem dmem 1023 12 4096
        idx :: Reg (Bit 4) <- mkReg 0

        rules
          "check": when cpu.done ==>
            let got = cpu.dmemAt (zeroExtend idx)
                exp = expected idx
            in if got /= exp
               then action
                    $display "FAIL: hazards dmem[%0d]=%0d expected %0d" idx got exp
                    $finish 1
               else if idx == 12
                    then action
                        $display "PASS: hazard interlock vector"
                        $finish 0
                    else idx := idx + 1
