# Copy to .env, set local paths, then source it from the repository root.
# BSV and BSC tests require both the Bluespec installation and Piccolo sources.
export BSC_HOME=/path/to/bsc/inst
export PICCOLO_ROOT=/path/to/Piccolo

# The released package is zlang-hdl==0.1.0a23 and provides the zlang CLI.
# Set this when PATH does not provide that tested release.
# export ZLANG_ROOT=/path/to/zlang

# Only needed when building a local Clash compiler or using a non-default GHC.
# export CLASH_COMPILER_ROOT=/path/to/clash-compiler
# export CLASH_GHC=/path/to/ghc
# export CLASH_PACKAGE_DB=/path/to/ghc/package.db
